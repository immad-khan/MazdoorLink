        <!-- Google Cloud Platform -->
        <mxCell id="ext_google_cloud" value="&lt;b&gt;Google Cloud Platform (GCP)&lt;/b&gt;&#xa;────────────────────────────&#xa;• Google Maps SDK for Flutter (Android/iOS/Web)&#xa;• Google Geocoding &amp; Places API&#xa;• Google Cloud Translation API v2&#xa;• Twin-Cities Live Mapping &amp; Reverse Geocode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;fontColor=#BF360C;fontSize=11;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="tier4_container">
          <mxGeometry x="800" y="45" width="310" height="205" as="geometry" />
        </mxCell>

        <!-- Groq AI Cloud -->
        <mxCell id="ext_groq_ai" value="&lt;b&gt;Groq AI Inference Cloud&lt;/b&gt;&#xa;────────────────────────────&#xa;• Ultra-Low-Latency LPU Inference&#xa;• Model: llama-3.3-70b-versatile&#xa;• System Prompting for Urdu Navigation&#xa;• Maps Voice Audio to App Screen Routes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;fontColor=#BF360C;fontSize=11;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="tier4_container">
          <mxGeometry x="1140" y="45" width="310" height="205" as="geometry" />
        </mxCell>

        <!-- External Payment & CDN Gateways -->
