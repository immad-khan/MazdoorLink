rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isConversationParticipant(conversationId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    function isBlocked(profile) {
      return profile.get('status', '') in ['suspended', 'banned'];
    }

    function hasWorkerRole(profile) {
      let roles = profile.get('roles', []);
      return profile.get('role', '') == 'worker' || (roles is list && 'worker' in roles);
    }

    function isApprovedWorker(profile) {
      let workerStatus = profile.get('workerStatus', null);
      return hasWorkerRole(profile) && !isBlocked(profile) &&
             (workerStatus == null ? profile.get('status', '') : workerStatus) == 'approved';
    }

    // Approval and account restrictions are admin decisions. A user can still
    // edit their profile or submit/re-submit a pending worker application.
    function mayWriteOwnProfile(before, after) {
      let status = after.get('status', '');
      let workerStatus = after.get('workerStatus', '');
      return after.get('role', '') != 'admin' &&
             (!hasWorkerRole(after) || hasWorkerRole(before) || workerStatus == 'pending') &&
             (status == before.get('status', '') || (status == 'pending' && !isBlocked(before))) &&
             (workerStatus == before.get('workerStatus', '') || workerStatus == 'pending') &&
             after.get('acceptsVisits', true) is bool;
    }

    // Users: directory is readable so users can log in via phone number lookup.
    // Customers may update rating and reviews on worker profile after a legacy job.
    match /users/{uid} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == uid &&
        mayWriteOwnProfile({}, request.resource.data);
      allow update: if isSignedIn() && (
        (request.auth.uid == uid && mayWriteOwnProfile(resource.data, request.resource.data)) ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviews', 'ratingCount', 'ratingSum'])
      );
      allow delete: if false;

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      }
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Existing repair bookings can finish normally. New bookings are visits.
    match /jobs/{jobId} {
      allow read: if isSignedIn();
      allow create: if false;
      allow update: if isSignedIn() &&
        (resource.data.customerId == request.auth.uid ||
         resource.data.workerId == request.auth.uid ||
         isAdmin());
      allow delete: if false;
    }

    function validVisitParticipants(visit) {
      let customer = get(/databases/$(database)/documents/users/$(visit.customerId)).data;
      let worker = get(/databases/$(database)/documents/users/$(visit.workerId)).data;
      return !isBlocked(customer) && isApprovedWorker(worker) &&
             worker.get('acceptsVisits', true) != false &&
             visit.customerName is string && visit.customerName == customer.get('name', '') &&
             visit.workerName is string && visit.workerName == worker.get('name', '');
    }

    function validVisitCreation(visit) {
      let fields = ['customerId', 'customerName', 'workerId', 'workerName', 'status',
                    'address', 'note', 'preferredAt', 'createdAt', 'updatedAt'];
      return visit.keys().hasAll(fields) && visit.keys().hasOnly(fields) &&
             visit.customerId == request.auth.uid &&
             visit.workerId is string && visit.workerId.matches('[^/]+') &&
             visit.workerId != visit.customerId && visit.status == 'requested' &&
             visit.address is string && visit.address.size() <= 300 && visit.address.trim().size() > 0 &&
             visit.note is string && visit.note.size() <= 500 &&
             visit.preferredAt is timestamp && visit.preferredAt > request.time &&
             visit.preferredAt < request.time + duration.value(31, 'd') &&
             visit.createdAt == request.time && visit.updatedAt == request.time &&
             validVisitParticipants(visit);
    }

    function validVisitTransition(visit, next) {
      return (visit.customerId == request.auth.uid &&
              visit.status in ['requested', 'accepted'] && next == 'cancelled') ||
             (visit.workerId == request.auth.uid && (
               (visit.status == 'requested' && (
                 next == 'declined' || (next == 'accepted' && visit.preferredAt > request.time &&
                   isApprovedWorker(get(/databases/$(database)/documents/users/$(request.auth.uid)).data))
               )) ||
               (visit.status == 'accepted' && next in ['completed', 'cancelled'])
             ));
    }

    // A visit's address and note are private to the two parties. No repair price
    // or payment fields are allowed, and only the visit status may change.
    match /visit_requests/{visitId} {
      allow read: if isSignedIn() &&
        (resource.data.customerId == request.auth.uid || resource.data.workerId == request.auth.uid);
      allow create: if isSignedIn() && validVisitCreation(request.resource.data);
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time &&
        validVisitTransition(resource.data, request.resource.data.status);
      allow delete: if false;
    }

    // Complaints / damage claims / security deposits:
    // Signed-in users may create complaints and read their own complaints.
    // Admins may read, update, and delete all complaints.
    match /complaints/{complaintId} {
      allow read: if isAdmin() || (isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.workerId == request.auth.uid
      ));
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /damage_claims/{claimId} {
      allow read, update: if isAdmin();
      allow create: if isSignedIn();
      allow delete: if false;
    }

    match /security_deposits/{depositId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.workerId == request.auth.uid);
      allow update: if isAdmin();
      allow create: if isSignedIn();
      allow delete: if false;
    }

    // Legacy workers directory: read-only for signed-in users.
    match /workers/{workerId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Conversations: only the two participants can read/update a thread.
    match /conversations/{conversationId} {
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() &&
        request.resource.data.participants.size() == 2 &&
        request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.participants;
      allow delete: if false;

      // Messages: only participants can read; a message must be created by its
      // sender within a conversation they belong to.
      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId);
        allow create: if isSignedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          isConversationParticipant(conversationId);
        allow update: if isConversationParticipant(conversationId);
        allow delete: if false;
      }
    }

    // Presence: anyone signed-in can read; you may only write your own doc.
    match /presence/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
