rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isConversationParticipant(conversationId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    // Users: directory is readable by any signed-in user; users edit only their
    // own doc (admins may update anyone).
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if false;
    }

    // Jobs: any signed-in user can read/create; updates only by the owning
    // customer, the assigned worker, or an admin.
    match /jobs/{jobId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        (resource.data.customerId == request.auth.uid ||
         resource.data.workerId == request.auth.uid ||
         isAdmin());
      allow delete: if false;
    }

    // Complaints / damage claims / security deposits: admin-only reads/updates,
    // signed-in users may create.
    match /complaints/{complaintId} {
      allow read, update: if isAdmin();
      allow create: if isSignedIn();
      allow delete: if false;
    }

    match /damage_claims/{claimId} {
      allow read, update: if isAdmin();
      allow create: if isSignedIn();
      allow delete: if false;
    }

    match /security_deposits/{depositId} {
      allow read, update: if isAdmin();
      allow create: if isSignedIn();
      allow delete: if false;
    }

    // Legacy workers directory: read-only for signed-in users.
    match /workers/{workerId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Conversations: only the two participants can read/update a thread.
    match /conversations/{conversationId} {
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() &&
        request.resource.data.participants.size() == 2 &&
        request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.participants;
      allow delete: if false;

      // Messages: only participants can read; a message must be created by its
      // sender within a conversation they belong to.
      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId);
        allow create: if isSignedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          isConversationParticipant(conversationId);
        allow update: if isConversationParticipant(conversationId);
        allow delete: if false;
      }
    }

    // Presence: anyone signed-in can read; you may only write your own doc.
    match /presence/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
